{
  "name": "ticket-ysws",
  "version": "1.0.0",
  "description": "Build a website themed around a movie, we ship you tickets to go watch more movies",
  "homepage": "https://github.com/mumuniazeez/ticket-ysws#readme",
  "bugs": {
    "url": "https://github.com/mumuniazeez/ticket-ysws/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mumuniazeez/ticket-ysws.git"
  },
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"pnpm --filter frontend dev:build\" \"pnpm --filter backend dev\"",
    "frontend": "pnpm --filter frontend dev",
    "backend": "pnpm --filter backend start:dev",
    "build": "pnpm --filter frontend build &&  pnpm --filter backend build"
  },
  "dependencies": {
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
